{
  "manifest_version": 3,
  "name": "Maps Business Extractor",
  "short_name": "Maps Extractor",
  "version": "1.0.0",
  "description": "Collect business names, phone numbers, websites, addresses and ratings from Google Maps search results and export them to CSV (Excel) or vCard.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extract places",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
