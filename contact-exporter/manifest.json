{
  "manifest_version": 3,
  "name": "Chat Contact Exporter",
  "short_name": "Contact Exporter",
  "version": "1.0.0",
  "description": "Export your WhatsApp Web contacts, unsaved chats and group members to CSV (Excel) or vCard. Works offline, data stays on your computer.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export contacts",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
