# Allow large video uploads (Hostinger honours these in most plans)
php_value upload_max_filesize 64M
php_value post_max_size 70M
php_value max_execution_time 300

# Serve .mind files as binary
AddType application/octet-stream .mind

# Protect the JSON index from direct download
<Files "experiences.json">
  Require all denied
</Files>
