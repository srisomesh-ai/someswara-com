# Clean URLs — each section is its own real page
RewriteEngine On

RewriteRule ^blueconnect/?$ /blueconnect.html [L]
RewriteRule ^trader/?$ /trader.html [L]
RewriteRule ^entrepreneur/?$ /entrepreneur.html [L]
RewriteRule ^hobby/?$ /hobby.html [L]
RewriteRule ^projects/?$ /projects.html [L]
RewriteRule ^contact/?$ /contact.html [L]
